# Servidor
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Base de datos (rehabmano)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rehabmano

# Autenticación
JWT_SECRET=cambiar_este_secreto
JWT_EXPIRES_IN=1h

# Órtesis (sprint 3). SERIAL_MOCK=true simula lecturas sin hardware (útil en
# desarrollo). Con SERIAL_MOCK=false se abre SERIAL_PORT como puerto serial real.
# El endpoint POST /api/sesiones/:id/conectar también acepta puerto="MOCK".
SERIAL_PORT=COM4
SERIAL_MOCK=true
SERIAL_BAUD_RATE=9600
#
# Formato de trama esperado del HC-06 (una lectura por línea, termina en \n):
#   L,<ms>,<adc_indice>,<adc_medio>,<adc_pulgar>,<fc>,<roll>,<pitch>,<yaw>,<rep>
#   ej.: L,12345,320,410,290,84,-3.20,12.50,0.80,17
# Ver backend/src/ortesis/protocolo.js.

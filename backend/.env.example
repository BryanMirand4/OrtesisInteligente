# Servidor
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Base de datos (rehabmano)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rehabmano

# Autenticación
JWT_SECRET=cambiar_este_secreto
JWT_EXPIRES_IN=1h

# Órtesis (sprint 3).
#   SERIAL_MOCK=true   -> datos simulados, sin hardware (desarrollo).
#   ORTESIS_NOMBRE_BT  -> nombre Bluetooth del HC-05 (el que se le puso con AT+NAME).
#                         La aplicación busca ese nombre entre los dispositivos
#                         emparejados en Windows y encuentra sola su puerto COM:
#                         en otra computadora basta con emparejar la órtesis.
#   SERIAL_PORT        -> déjelo vacío. Solo fuerza un puerto fijo (p. ej. pruebas
#                         con el Arduino conectado por cable USB).
#   SERIAL_BAUD_RATE   -> debe coincidir con el sketch y con AT+UART del HC-05.
SERIAL_MOCK=true
ORTESIS_NOMBRE_BT=ORTESIS
SERIAL_PORT=
SERIAL_BAUD_RATE=115200
#
# Formato de trama esperado del HC-06 (una lectura por línea, termina en \n):
#   L,<ms>,<adc_indice>,<adc_medio>,<adc_pulgar>,<fc>,<roll>,<pitch>,<yaw>,<rep>
#   ej.: L,12345,320,410,290,84,-3.20,12.50,0.80,17
# Ver backend/src/ortesis/protocolo.js.
